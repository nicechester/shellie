# Required (if missing, the agent boots into "setup-required mode": these
# can only be filled in from the web UI).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_USER_ID=123456789

# Everything below is optional. Values set here are only "initial" values
# that get layered on top of the built-in defaults at first startup. Any
# value changed later via the web UI (or the Telegram /set command) is
# stored in settings.json, which always takes priority over this file --
# editing this file afterward has no effect on that key, even across a
# restart (the settings.json override persists).

# Gemini model chain to try in order on 429/errors
# GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite

# Gemini API call timeout (seconds)
# GEMINI_TIMEOUT_SEC=120

# Delay before switching to the next model (seconds)
# GEMINI_FALLBACK_DELAY_SEC=1

# Base cooldown before retrying the whole model chain after rate limit (seconds)
# GEMINI_RETRY_BASE_DELAY_SEC=60

# Max retries of the whole model chain after cooldown (0 = no retry)
# GEMINI_MAX_RETRIES=2

# System prompt sent to the LLM
# SYSTEM_PROMPT=You are Shellie, a personal assistant running on the user's own computer. Answer questions directly from your own knowledge whenever possible. Only call execute_shell when the task genuinely requires running something on this machine (e.g. file operations, running scripts, checking local system state). Use append_memory only when the user explicitly asks you to remember something.

# Maximum function-calling loop iterations per message
# FC_MAX_LOOPS=15

# Max automatic continuations when a turn hits FC_MAX_LOOPS (0 = off; /continue still works)
# FC_MAX_CONTINUATIONS=2

# Recent conversation turns to retain (0=single-shot)
# CONTEXT_TURNS=10

# Idle time before auto-resetting conversation context (minutes, 0=off)
# IDLE_RESET_MINUTES=30

# Shell command execution timeout (seconds)
# SHELL_TIMEOUT_SEC=45

# Maximum shell output length (characters)
# SHELL_OUTPUT_LIMIT=3000

# getUpdates long-polling timeout (seconds)
# POLL_TIMEOUT_SEC=30

# Log output level (DEBUG/INFO/WARNING/ERROR)
# LOG_LEVEL=INFO

# Enable the local settings web server
# WEB_ENABLED=true

# Local settings web server port
# WEB_PORT=8321

# Shell executable path ('auto' or absolute path)
# SHELL_PATH=auto

# HTTP MCP server list (JSON array; normally managed from web UI; web-only secret)
# MCP_SERVERS=

# Model used for execute_web_search (google_search grounding)
# SEARCH_MODEL=gemma-4-26b-a4b-it

# Config/context directory: settings, memories, offset file live here.
# Read from os.environ, .env, or default at startup.
# SHELLIE_HOME=~/.shellie

# User workspace: job outputs, generated code, documents saved here (separate from config).
# Read from os.environ, .env, or default at startup.
# SHELLIE_WORKSPACE=~/workspace
