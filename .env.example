# Required (if missing, the agent boots into "setup-required mode": these
# can only be filled in from the web UI).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_USER_ID=123456789

# Everything below is optional. Values set here are only "initial" values
# that get layered on top of the built-in defaults at first startup. Any
# value changed later via the web UI (or the Telegram /set command) is
# stored in settings.json, which always takes priority over this file --
# editing this file afterward has no effect on that key, even across a
# restart (the settings.json override persists).
# GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite
# GEMINI_TIMEOUT_SEC=60
# GEMINI_FALLBACK_DELAY_SEC=1
# SYSTEM_PROMPT=당신은 Shellie, 사용자의 컴퓨터에서 구동되는 경량 에이전트입니다. 필요시 셸 명령어와 메모리 툴을 활용하세요.
# FC_MAX_LOOPS=5
# CONTEXT_TURNS=10
# IDLE_RESET_MINUTES=30
# SHELL_TIMEOUT_SEC=45
# SHELL_OUTPUT_LIMIT=3000
# SHELL_PATH=auto
# POLL_TIMEOUT_SEC=30
# LOG_LEVEL=INFO
# WEB_ENABLED=true
# WEB_PORT=8321
